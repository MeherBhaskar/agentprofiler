# Build with: docker build -t agentprofiler/base:latest -f Dockerfile.base .

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install AgentEval
COPY . /app/agentprofiler
RUN pip install -e /app/agentprofiler

# Default command
CMD ["python", "-m", "agentprofiler.runner", "--help"]